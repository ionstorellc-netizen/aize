# --- API keys (optional here; you can also paste them in the Integrations page) ---
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
PEXELS_API_KEY=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# --- security ---
# Fernet key used to encrypt keys saved from the UI (auto-generated into storage/.secret_key if empty)
APP_SECRET_KEY=
# Enables HTTP Basic auth for the whole app (any username, this password)
STUDIO_PASSWORD=

# --- runtime ---
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/studio   (default: SQLite in storage/studio.db)
# STUDIO_STORAGE=/absolute/path/to/storage
# WHISPER_MODEL=small        # small | medium | large-v3 | /path/to/ctranslate2-model
# WHISPER_DEVICE=cpu         # cpu | cuda
# WHISPER_COMPUTE=int8       # int8 | float16
# WORKER_THREADS=2
# CORS_ORIGINS=http://localhost:5173
